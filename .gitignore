@'
# Flutter and Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
.vscode/
*.iml

# Android build outputs and local configuration
android/.gradle/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore

# Secrets and environment files
.env
.env.*
!.env.example
secrets/
credentials.json
client_secret*.json

# Local databases and backups
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*Backup*
*backup*

# Operating system
.DS_Store
Thumbs.db
'@ | Set-Content -Path .gitignore -Encoding utf8